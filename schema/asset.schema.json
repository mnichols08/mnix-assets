{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MNIX asset catalog",
  "type": "object",
  "required": ["schemaVersion", "assets"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "platform",
        "category",
        "version",
        "description",
        "distributionMode",
        "license",
        "redistributable",
        "legalNotes",
        "enabled"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "legalNotes": {
          "type": "string",
          "minLength": 1
        },
        "downloadUrl": {
          "type": ["string", "null"]
        },
        "sourceUrl": {
          "type": ["string", "null"]
        },
        "homepage": {
          "type": ["string", "null"]
        },
        "licenseSource": {
          "type": ["string", "null"]
        },
        "releaseTag": {
          "type": ["string", "null"]
        },
        "sha256": {
          "type": ["string", "null"]
        },
        "archiveType": {
          "type": ["string", "null"]
        },
        "sourceNotes": {
          "type": ["string", "null"]
        },
        "distributionMode": {
          "enum": ["hosted", "external-download", "user-supplied"]
        },
        "enabled": {
          "type": "boolean"
        },
        "redistributable": {
          "type": "boolean"
        },
        "browserFetch": {
          "type": "boolean"
        },
        "sizeBytes": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "runtime": {
          "type": "object",
          "description": "Optional engine, memoryMiB, diskAssetId, bootAssetId, unpackedSha256, unpackedSizeBytes."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "distributionMode": {
                "const": "hosted"
              }
            }
          },
          "then": {
            "required": ["sha256", "sizeBytes", "licenseSource"],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "anyOf": [
              {
                "properties": {
                  "redistributable": {
                    "const": true
                  }
                }
              },
              {
                "required": [
                  "distributionAuthorization",
                  "authorizationDate",
                  "sourceUrl"
                ],
                "properties": {
                  "redistributable": {
                    "const": false
                  },
                  "distributionAuthorization": {
                    "enum": [
                      "owner-requested-existing-collection",
                      "owner-requested-hosting"
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
